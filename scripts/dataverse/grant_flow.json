{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "When_an_access_grant_is_added_or_modified": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 4,
          "subscriptionRequest/entityname": "chp_accessgrant",
          "subscriptionRequest/scope": 4,
          "subscriptionRequest/filteringattributes": "chp_email,chp_bccustomerno,chp_webrole,statecode"
        }
      }
    }
  },
  "actions": {
    "Get_grant": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "chp_accessgrants",
          "recordId": "@triggerOutputs()?['body/chp_accessgrantid']",
          "$select": "chp_accessgrantid,chp_email,chp_bccustomerno,chp_webrole,statecode"
        }
      }
    },
    "List_contacts_by_email": {
      "type": "OpenApiConnection",
      "runAfter": {
        "Get_grant": [
          "Succeeded"
        ]
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "contacts",
          "$select": "contactid,_parentcustomerid_value",
          "$filter": "emailaddress1 eq '@{replace(outputs('Get_grant')?['body/chp_email'], '''', '''''')}' and statecode eq 0",
          "$top": 2
        }
      }
    },
    "Switch_on_contact_count": {
      "type": "Switch",
      "runAfter": {
        "List_contacts_by_email": [
          "Succeeded"
        ]
      },
      "expression": "@length(outputs('List_contacts_by_email')?['body/value'])",
      "cases": {
        "No_contact": {
          "case": 0,
          "actions": {
            "Set_status_Pending": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "chp_accessgrants",
                  "recordId": "@triggerOutputs()?['body/chp_accessgrantid']",
                  "item/chp_status": "@if(equals(outputs('Get_grant')?['body/statecode'], 1), 775000004, 775000000)"
                }
              }
            }
          }
        },
        "One_contact": {
          "case": 1,
          "actions": {
            "Get_parent_account": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "accounts",
                  "recordId": "@first(outputs('List_contacts_by_email')?['body/value'])?['_parentcustomerid_value']",
                  "$select": "chp_bccustomerno"
                }
              }
            },
            "Customer_matches": {
              "type": "If",
              "runAfter": {
                "Get_parent_account": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@actions('Get_parent_account')?['status']",
                      "Succeeded"
                    ]
                  },
                  {
                    "equals": [
                      "@empty(outputs('Get_grant')?['body/chp_bccustomerno'])",
                      false
                    ]
                  },
                  {
                    "equals": [
                      "@outputs('Get_parent_account')?['body/chp_bccustomerno']",
                      "@outputs('Get_grant')?['body/chp_bccustomerno']"
                    ]
                  }
                ]
              },
              "actions": {
                "Grant_role_name": {
                  "type": "Compose",
                  "runAfter": {},
                  "inputs": "@if(equals(outputs('Get_grant')?['body/chp_webrole'], 775000000), 'Full Access', if(equals(outputs('Get_grant')?['body/chp_webrole'], 775000001), 'Orders & Delivery', if(equals(outputs('Get_grant')?['body/chp_webrole'], 775000002), 'Finance & Documents', if(equals(outputs('Get_grant')?['body/chp_webrole'], 775000003), 'View Only', ''))))"
                },
                "List_current_business_roles": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Grant_role_name": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "ListRecords",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "powerpagecomponents",
                      "$select": "powerpagecomponentid,name",
                      "$filter": "powerpagecomponenttype eq 11 and _powerpagesiteid_value eq f44e98b4-3da3-4f8d-8f79-fbb244454741 and (name eq 'Full Access' or name eq 'Orders & Delivery' or name eq 'Finance & Documents' or name eq 'View Only') and powerpagecomponent_mspp_webrole_contact/any(c: c/contactid eq @{first(outputs('List_contacts_by_email')?['body/value'])?['contactid']})"
                    }
                  }
                },
                "Grant_is_active": {
                  "type": "If",
                  "runAfter": {
                    "List_current_business_roles": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "equals": [
                      "@outputs('Get_grant')?['body/statecode']",
                      0
                    ]
                  },
                  "actions": {
                    "Remove_other_business_roles": {
                      "type": "Foreach",
                      "runAfter": {},
                      "foreach": "@outputs('List_current_business_roles')?['body/value']",
                      "actions": {
                        "Is_other_role": {
                          "type": "If",
                          "runAfter": {},
                          "expression": {
                            "not": {
                              "equals": [
                                "@items('Remove_other_business_roles')?['name']",
                                "@outputs('Grant_role_name')"
                              ]
                            }
                          },
                          "actions": {
                            "Unrelate_other_role": {
                              "type": "OpenApiConnection",
                              "runAfter": {},
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "DisassociateEntities",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "contacts",
                                  "recordId": "@first(outputs('List_contacts_by_email')?['body/value'])?['contactid']",
                                  "associationEntityRelationship": "powerpagecomponent_mspp_webrole_contact",
                                  "$id": "@items('Remove_other_business_roles')?['@odata.id']"
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {}
                          }
                        }
                      }
                    },
                    "List_web_role": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "Remove_other_business_roles": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "ListRecords",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "powerpagecomponents",
                          "$select": "powerpagecomponentid",
                          "$filter": "name eq '@{outputs('Grant_role_name')}' and powerpagecomponenttype eq 11 and _powerpagesiteid_value eq f44e98b4-3da3-4f8d-8f79-fbb244454741",
                          "$top": 1
                        }
                      }
                    },
                    "Relate_web_role_to_contact": {
                      "type": "OpenApiConnection",
                      "runAfter": {
                        "List_web_role": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "host": {
                          "connectionName": "shared_commondataserviceforapps",
                          "operationId": "AssociateEntities",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                        },
                        "parameters": {
                          "entityName": "contacts",
                          "recordId": "@first(outputs('List_contacts_by_email')?['body/value'])?['contactid']",
                          "associationEntityRelationship": "powerpagecomponent_mspp_webrole_contact",
                          "item/@odata.id": "@first(outputs('List_web_role')?['body/value'])?['@odata.id']"
                        }
                      }
                    },
                    "Role_granted_or_already_granted": {
                      "type": "If",
                      "runAfter": {
                        "Relate_web_role_to_contact": [
                          "Succeeded",
                          "Failed"
                        ]
                      },
                      "expression": {
                        "or": [
                          {
                            "equals": [
                              "@actions('Relate_web_role_to_contact')?['status']",
                              "Succeeded"
                            ]
                          },
                          {
                            "contains": [
                              "@toLower(string(outputs('Relate_web_role_to_contact')?['body']))",
                              "already exists"
                            ]
                          },
                          {
                            "contains": [
                              "@toLower(string(outputs('Relate_web_role_to_contact')?['body']))",
                              "duplicate key"
                            ]
                          },
                          {
                            "contains": [
                              "@toLower(string(outputs('Relate_web_role_to_contact')?['body']))",
                              "0x80040237"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Set_status_Applied": {
                          "type": "OpenApiConnection",
                          "runAfter": {},
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "UpdateOnlyRecord",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "chp_accessgrants",
                              "recordId": "@triggerOutputs()?['body/chp_accessgrantid']",
                              "item/chp_status": 775000001,
                              "item/chp_Contact@odata.bind": "contacts(@{first(outputs('List_contacts_by_email')?['body/value'])?['contactid']})",
                              "item/chp_appliedon": "@utcNow()"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Fail_role_not_granted": {
                            "type": "Terminate",
                            "runAfter": {},
                            "inputs": {
                              "runStatus": "Failed",
                              "runError": {
                                "code": "RoleNotGranted",
                                "message": "Could not add the web role to the contact (web role missing on the site, or relate failed). The grant stays unchanged."
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Remove_all_business_roles": {
                        "type": "Foreach",
                        "runAfter": {},
                        "foreach": "@outputs('List_current_business_roles')?['body/value']",
                        "actions": {
                          "Unrelate_role": {
                            "type": "OpenApiConnection",
                            "runAfter": {},
                            "inputs": {
                              "host": {
                                "connectionName": "shared_commondataserviceforapps",
                                "operationId": "DisassociateEntities",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                              },
                              "parameters": {
                                "entityName": "contacts",
                                "recordId": "@first(outputs('List_contacts_by_email')?['body/value'])?['contactid']",
                                "associationEntityRelationship": "powerpagecomponent_mspp_webrole_contact",
                                "$id": "@items('Remove_all_business_roles')?['@odata.id']"
                              }
                            }
                          }
                        }
                      },
                      "Set_status_Revoked": {
                        "type": "OpenApiConnection",
                        "runAfter": {
                          "Remove_all_business_roles": [
                            "Succeeded"
                          ]
                        },
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "UpdateOnlyRecord",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "chp_accessgrants",
                            "recordId": "@triggerOutputs()?['body/chp_accessgrantid']",
                            "item/chp_status": 775000004,
                            "item/chp_Contact@odata.bind": "contacts(@{first(outputs('List_contacts_by_email')?['body/value'])?['contactid']})",
                            "item/chp_appliedon": "@utcNow()"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Set_status_Customer_mismatch": {
                    "type": "OpenApiConnection",
                    "runAfter": {},
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "UpdateOnlyRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "chp_accessgrants",
                        "recordId": "@triggerOutputs()?['body/chp_accessgrantid']",
                        "item/chp_status": "@if(equals(outputs('Get_grant')?['body/statecode'], 1), 775000004, 775000002)"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "default": {
        "actions": {
          "Set_status_Duplicate_email": {
            "type": "OpenApiConnection",
            "runAfter": {},
            "inputs": {
              "host": {
                "connectionName": "shared_commondataserviceforapps",
                "operationId": "UpdateOnlyRecord",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
              },
              "parameters": {
                "entityName": "chp_accessgrants",
                "recordId": "@triggerOutputs()?['body/chp_accessgrantid']",
                "item/chp_status": "@if(equals(outputs('Get_grant')?['body/statecode'], 1), 775000004, 775000003)"
              }
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
