{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "Site URL (chp_SiteUrl)": {
      "defaultValue": "",
      "type": "String",
      "metadata": {
        "schemaName": "chp_SiteUrl",
        "description": "Site URL"
      }
    }
  },
  "triggers": {
    "When_a_password_reset_email_is_added": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 1,
          "subscriptionRequest/entityname": "email",
          "subscriptionRequest/scope": 4,
          "subscriptionRequest/filterexpression": "contains(subject,'Password Reset') and directioncode eq true and _regardingobjectid_value ne null"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "Get_contact": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "contacts",
          "recordId": "@triggerOutputs()?['body/_regardingobjectid_value']",
          "$select": "emailaddress1,fullname"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {}
    },
    "Has_reset_link": {
      "type": "If",
      "expression": {
        "equals": [
          "@contains(coalesce(triggerOutputs()?['body/description'], ''), 'ResetPassword?')",
          true
        ]
      },
      "actions": {
        "Reset_query": {
          "type": "Compose",
          "runAfter": {},
          "inputs": "@replace(first(split(first(split(split(triggerOutputs()?['body/description'], 'ResetPassword?')[1], '''')), '\"')), '&amp;', '&')"
        },
        "Send_reset_email": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Reset_query": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@{outputs('Get_contact')?['body/emailaddress1']}",
              "emailMessage/Subject": "Reset your Concreat Connect password",
              "emailMessage/Body": "<div style=\"margin:0;padding:0;background:#f3f5f9\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f5f9;padding:24px 12px;font-family:'Segoe UI',Arial,Helvetica,sans-serif\"><tr><td align=\"center\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%;max-width:600px;background:#ffffff;border:1px solid #e3e7ef;border-radius:10px\"><tr><td style=\"padding:22px 32px 18px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"vertical-align:middle;padding-right:14px\"><img src=\"@{parameters('Site URL (chp_SiteUrl)')}/concreat-logo-email.png\" width=\"66\" height=\"48\" alt=\"CONCREAT\" style=\"display:block;border:0;width:66px;height:48px;font:700 18px Arial,sans-serif;letter-spacing:2px;color:#1b2e63\"></td><td style=\"vertical-align:middle;padding-left:14px;border-left:1px solid #e3e7ef\"><div style=\"font-size:16px;font-weight:700;color:#1b2e63\">Concreat Connect</div><div style=\"font-size:12px;color:#6b7385\">Customer Portal</div></td></tr></table></td></tr><tr><td style=\"height:4px;background:#1b2e63;font-size:0;line-height:0\">&nbsp;</td></tr><tr><td style=\"padding:32px 32px 8px\"><h1 style=\"margin:0 0 16px;font-size:22px;line-height:1.3;color:#0c1633\">Reset your password</h1><p style=\"margin:0 0 12px;font-size:15px;line-height:1.6;color:#2b3445\">Hello @{outputs('Get_contact')?['body/fullname']},</p><p style=\"margin:0 0 24px;font-size:15px;line-height:1.6;color:#2b3445\">We received a request to reset your Concreat Connect password. Use the button below to choose a new one.</p><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-radius:7px;background:#1b2e63\"><a href=\"@{parameters('Site URL (chp_SiteUrl)')}/reset-password?@{outputs('Reset_query')}&amp;email=@{encodeUriComponent(outputs('Get_contact')?['body/emailaddress1'])}\" style=\"display:inline-block;padding:13px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:7px\">Reset your password</a></td></tr></table><div style=\"margin:24px 0 0;padding:12px 14px;background:#f3f6fb;border-radius:7px;font-size:13px;line-height:1.5;color:#4a5468\">This link expires in 1 hour.</div><p style=\"margin:20px 0 4px;font-size:12px;line-height:1.5;color:#6b7385\">Button not working? Copy and paste this link into your browser:</p><p style=\"margin:0 0 8px;font-size:12px;line-height:1.5;word-break:break-all\"><a href=\"@{parameters('Site URL (chp_SiteUrl)')}/reset-password?@{outputs('Reset_query')}&amp;email=@{encodeUriComponent(outputs('Get_contact')?['body/emailaddress1'])}\" style=\"color:#2560a8\">@{parameters('Site URL (chp_SiteUrl)')}/reset-password?@{outputs('Reset_query')}&amp;email=@{encodeUriComponent(outputs('Get_contact')?['body/emailaddress1'])}</a></p></td></tr><tr><td style=\"padding:20px 32px 28px;border-top:1px solid #eef1f6\"><p style=\"margin:0 0 6px;font-size:12px;line-height:1.5;color:#6b7385\">Didn't ask for this? You can safely ignore this email.</p><p style=\"margin:0;font-size:12px;line-height:1.5;color:#6b7385\">Need assistance? Contact the <strong style=\"color:#2b3445\">Concreat Customer Service Center</strong> at <strong style=\"color:#2b3445\">(02) 8849-3600</strong>.</p></td></tr></table><p style=\"margin:14px 0 0;font-size:11px;color:#9aa2b1\">&copy; Concreat Holdings</p></td></tr></table></div>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Cancel_dataverse_email": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "emails",
              "recordId": "@triggerOutputs()?['body/activityid']",
              "item/statecode": 2,
              "item/statuscode": 5
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Send_reset_email": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {
          "Stop_no_link": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "message": "Reset link not found in the password reset email"
              }
            }
          }
        }
      },
      "runAfter": {
        "Get_contact": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
