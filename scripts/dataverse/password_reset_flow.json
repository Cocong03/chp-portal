{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "Site URL (chp_SiteUrl)": {
      "defaultValue": "",
      "type": "String",
      "metadata": {
        "schemaName": "chp_SiteUrl",
        "description": "Site URL"
      }
    }
  },
  "triggers": {
    "When_a_password_reset_email_is_added": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 1,
          "subscriptionRequest/entityname": "email",
          "subscriptionRequest/scope": 4,
          "subscriptionRequest/filterexpression": "contains(subject,'Password Reset') and directioncode eq true and _regardingobjectid_value ne null"
        },
        "authentication": "@parameters('$authentication')"
      }
    }
  },
  "actions": {
    "Get_contact": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "contacts",
          "recordId": "@triggerOutputs()?['body/_regardingobjectid_value']",
          "$select": "emailaddress1,fullname"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {}
    },
    "Has_reset_link": {
      "type": "If",
      "expression": {
        "equals": [
          "@contains(coalesce(triggerOutputs()?['body/description'], ''), 'ResetPassword?')",
          true
        ]
      },
      "actions": {
        "Reset_query": {
          "type": "Compose",
          "runAfter": {},
          "inputs": "@replace(first(split(first(split(split(triggerOutputs()?['body/description'], 'ResetPassword?')[1], '''')), '\"')), '&amp;', '&')"
        },
        "Send_reset_email": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Reset_query": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@{outputs('Get_contact')?['body/emailaddress1']}",
              "emailMessage/Subject": "Reset your Concreat Connect password",
              "emailMessage/Body": "<p>Hello @{outputs('Get_contact')?['body/fullname']},</p><p>We received a request to reset your Concreat Connect password. Use the link below to choose a new one.</p><p><a href=\"@{parameters('Site URL (chp_SiteUrl)')}/reset-password?@{outputs('Reset_query')}&amp;email=@{encodeUriComponent(outputs('Get_contact')?['body/emailaddress1'])}\" style=\"display:inline-block;padding:10px 18px;background:#1d2b5f;color:#ffffff;text-decoration:none;border-radius:6px\">Reset your password</a></p><p>This link expires in 1 hour.</p><p>If you didn't ask for this, you can ignore this email.</p><p>Need assistance? Contact Concreat Customer Service Center at (02) 8849-3600.</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Cancel_dataverse_email": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateOnlyRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "emails",
              "recordId": "@triggerOutputs()?['body/activityid']",
              "item/statecode": 2,
              "item/statuscode": 5
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Send_reset_email": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {
          "Stop_no_link": {
            "type": "Terminate",
            "runAfter": {},
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "message": "Reset link not found in the password reset email"
              }
            }
          }
        }
      },
      "runAfter": {
        "Get_contact": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
